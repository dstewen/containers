<Config>
  <LogLevel>${READARR__LOG_LEVEL:-info}</LogLevel>
  <UrlBase>${READARR__URL_BASE}</UrlBase>
  <Branch>${READARR__BRANCH}</Branch>
  <ApiKey>${READARR__API_KEY:-}</ApiKey>
  <AuthenticationMethod>${READARR__AUTHENTICATION_METHOD:-None}</AuthenticationMethod>
  <AuthenticationRequired>${READARR__AUTHENTICATION_REQUIRED:-None}</AuthenticationRequired>
  <InstanceName>${READARR__INSTANCE_NAME:-Readarr}</InstanceName>
  <PostgresUser>postgres</PostgresUser>
  <PostgresPassword>postgres</PostgresPassword>
  <PostgresPort>5432</PostgresPort>
  <PostgresHost>localhost</PostgresHost>
  <PostgresMainDb>readarr</PostgresMainDb>
  <PostgresLogDb>readarr_log</PostgresLogDb>
  <PostgresCacheDb>readarr_cache</PostgresCacheDb>
  <Port>${READARR__PORT:-8787}</Port>
  <BindAddress>*</BindAddress>
  <LaunchBrowser>False</LaunchBrowser>
  <EnableSsl>False</EnableSsl>
  <SslPort>6969</SslPort>
  <SslCertPath></SslCertPath>
  <SslCertPassword></SslCertPassword>
  <UpdateMechanism>BuiltIn</UpdateMechanism>
  <AnalyticsEnabled>${READARR__ANALYTICS_ENABLED:-False}</AnalyticsEnabled>
  <Theme>${READARR__THEME:-auto}</Theme>
  <DatabaseType>sqlite</DatabaseType>
</Config>
